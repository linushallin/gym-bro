# Postgres via Supabase. Use the *transaction* pooler (port 6543) for the app —
# it's what lets many concurrent serverless functions share a small number of
# real DB connections. DIRECT_URL (session pooler / port 5432) is only used by
# `prisma migrate`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase Dashboard → Project Settings → API Keys.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Publishable key (sb_publishable_…) or the legacy "anon" key.
SUPABASE_PUBLISHABLE_KEY=""
# Secret key (sb_secret_…) or the legacy "service_role" key. Server-only —
# bypasses all access rules. Only used to delete accounts. Never commit it.
SUPABASE_SECRET_KEY=""
